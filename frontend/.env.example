# Copy to .env. Vite only exposes vars prefixed with VITE_ to the browser.
# NEVER put secrets here — anything in a VITE_ var ships to the client.

# Base URL of the Node Web API.
VITE_API_URL=http://localhost:4000

# Supabase project URL + anon (public) key — used by supabase-js for sign-in only.
# The anon key is safe to expose (RLS grants it no table access). Added in M1.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Show "Continue with Google" on the sign-in screen. Enable ONLY after turning on
# the Google provider in Supabase (Authentication → Providers → Google) and adding
# this site's URL to Authentication → URL Configuration → Redirect URLs.
# Setup steps: docs/notes/M6-uat-readiness.md §Google sign-in.
VITE_GOOGLE_AUTH=0

# Demo mode (in-memory sample data, no backend). Same as adding ?demo to the URL.
# VITE_DEMO=1
