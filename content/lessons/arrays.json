      "code": "public class Main {\n    public static void main(String[] args) {\n        int[] a = {3, 9, 2, 12, 7};\n        int max = a[0];\n        for (int i = 1; i < a.length; i++) {\n            if (a[i] > max) ____;\n            System.out.println(max);\n        }\n    }\n}",
      "accepted": [
        "max = a[i]",
        "max = Math.max(max, a[i])"
      ],
