    {
      "id": "ideas",
      "type": "explain",
      "title": "Why binary search is fast",
      "points": [
        "Keep a window `lo..hi`. Check the **middle**; throw away the half that can’t contain the target.",
        "Each step halves the window: **O(log n)**. A million items take about 20 checks.",
        "It **requires sorted data**. On unsorted data it can throw away the half that holds the answer.",
        "Linear search (check every item) is O(n) but works on anything."
      ],
      "pattern": "while (lo <= hi) {\n    int mid = lo + (hi - lo) / 2;\n    if (a[mid] == t) return mid;\n    if (a[mid] < t) lo = mid + 1; else hi = mid - 1;\n}"
    },
    {
      "id": "p2",
      "type": "predict",
      "prompt": "A classic trap. What does this print?",
      "code": "public class Main {\n    public static void main(String[] args) {\n        int[] a = {9, 2, 7, 4, 1}; // NOT sorted\n        int target = 9;\n        int lo = 0, hi = a.length - 1;\n        String result = \"not found\";\n        while (lo <= hi) {\n            int mid = (lo + hi) / 2;\n            if (a[mid] == target) { result = \"found at \" + mid; break; }\n            if (a[mid] < target) lo = mid + 1;\n            else hi = mid - 1;\n        }\n        System.out.println(result);\n    }\n}",
      "options": [
        {
          "text": "Crashes: ArrayIndexOutOfBoundsException",
          "why": "lo and hi always stay inside the array; the loop just ends."
        },
        {
          "text": "found at 4",
          "why": "a[4] is 1, not 9."
        },
        {
          "text": "found at 0",
          "why": "Binary search assumes sorted data. It saw 7 < 9 and threw away the LEFT half, where 9 actually was."
        },
        {
          "text": "not found",
          "why": "Yes. On unsorted data binary search can discard the half holding the answer. Sort first, or use linear search."
        }
      ],
      "answer": 3
    },
