    {
      "id": "hook",
      "type": "hook",
      "title": "Guess the number, like a pro",
      "body": "I’m thinking of a number from 1 to 1,000,000. Guess, and I’ll say *higher* or *lower*. Always guess the middle and you’ll need about **20** guesses. That idea is **binary search**, and it only works on **sorted** data.\n\nIn five minutes you’ll watch the search window halve, see it fail on unsorted data, and fix the key line yourself."
    },
    {
      "id": "p1",
      "type": "predict",
      "prompt": "What does this program print?",
      "code": "public class Main {\n    public static void main(String[] args) {\n        int[] a = {2, 5, 8, 12, 16, 23, 38}; //~ Sorted, which binary search needs.\n        int target = 23;\n        int lo = 0, hi = a.length - 1; //~ If 23 is here, it is somewhere between lo and hi.\n        while (lo <= hi) {\n            int mid = (lo + hi) / 2; //~ Look at the middle of what's left.\n            if (a[mid] == target) {\n                System.out.println(\"found at \" + mid); //~ Found it.\n                break;\n            } else if (a[mid] < target) {\n                lo = mid + 1; //~ Too small: the target must be to the right. Throw away the left half.\n            } else {\n                hi = mid - 1; //~ Too big: throw away the right half.\n            }\n        }\n    }\n}",
      "options": [
        {
          "text": "found at 3",
          "why": "Index 3 was the first middle, but a[3] is 12, too small, so the search moved right."
        },
        {
          "text": "found at 23",
          "why": "It prints mid, the index, not the value."
        },
        {
          "text": "found at 5",
          "why": "Right: 23 is at index 5, found after checking indexes 3 and then 5."
        },
        {
          "text": "found at 6",
          "why": "Indexes start at 0: 2 is at 0, …, 23 is at 5."
        }
      ],
      "answer": 2
