    {
      "id": "hook",
      "type": "hook",
      "title": "Every app is full of objects",
      "body": "A banking app has accounts, a college portal has students, and a game has players. Each is an **object** with its own data, built from a **class** (the blueprint). This is the O in OOP, and a guaranteed interview topic.\n\nIn five minutes you’ll watch two objects live side by side in memory, and write a constructor yourself."
    },
    {
      "id": "p1",
      "type": "predict",
      "prompt": "What does this program print?",
      "code": "class Counter {\n    private int count; //~ A field: EACH Counter object gets its own count.\n\n    void tick() {\n        count++; //~ Add 1 to THIS object's count.\n    }\n\n    int get() {\n        return count;\n    }\n}\n\npublic class Main {\n    public static void main(String[] args) {\n        Counter a = new Counter(); //~ new builds an object from the Counter blueprint. Its count starts at 0.\n        Counter b = new Counter(); //~ A second, separate Counter object with its own count.\n        a.tick(); //~ Only a's count goes up.\n        a.tick();\n        b.tick();\n        System.out.println(a.get() + \" \" + b.get()); //~ a ticked twice and b once.\n    }\n}",
      "options": [
        {
          "text": "2 1",
          "why": "Right. Each object has its own count field. a ticked twice, b once."
        },
        {
          "text": "0 0",
          "why": "Fields start at 0, but tick() adds 1 each time it is called."
        },
        {
          "text": "3 3",
          "why": "Fields belong to each object, so the two counters don’t share a count."
        },
        {
          "text": "3 1",
          "why": "b.tick() changes only b. a’s count is 2."
        }
      ],
      "answer": 0
    },
