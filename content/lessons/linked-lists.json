{
  "skillId": "linked-lists",
  "title": "Linked lists: a chain of nodes",
  "minutes": 5,
  "version": 1,
  "steps": [
    {
      "id": "hook",
      "type": "hook",
      "title": "A list with no fixed size",
      "body": "An array is one solid block. A **linked list** is a chain: each **node** holds a value and a pointer to the next node. Adding at the front is instant, and linked-list questions (reverse it, find the middle) are interview classics.\n\nIn five minutes you’ll build a chain and walk it node by node, watching the pointers in memory."
    },
    {
      "id": "p1",
      "type": "predict",
      "prompt": "What does this program print?",
      "code": "class Node {\n    int value;\n    Node next;\n\n    Node(int value) {\n        this.value = value;\n    }\n}\n\npublic class Main {\n    public static void main(String[] args) {\n        Node head = new Node(1); //~ The first node. head remembers where the list starts.\n        head.next = new Node(2); //~ Link a second node after it.\n        head.next.next = new Node(3); //~ And a third.\n        int sum = 0;\n        for (Node cur = head; cur != null; cur = cur.next) { //~ Walk: start at head, follow next until it's null.\n            sum += cur.value; //~ Use the current node's value.\n        }\n        System.out.println(sum);\n    }\n}",
      "options": [
        {
          "text": "6",
          "why": "Right: the walk visits 1, 2 and 3, following next until it reaches null."
        },
        {
          "text": "3",
          "why": "The loop visits every node, not just the last."
        },
        {
          "text": "1",
          "why": "cur = cur.next moves on to the following node each round."
        },
        {
          "text": "Crashes: NullPointerException",
          "why": "The loop stops as soon as cur is null, before reading its value."
        }
      ],
      "answer": 0
    },
