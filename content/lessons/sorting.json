    {
      "id": "hook",
      "type": "hook",
      "title": "The most-asked algorithm family",
      "body": "Leaderboards, price filters, and \"top 10 scores\": sorting is everywhere, and interviewers love asking you to sort by hand. The simplest idea is **bubble sort**: keep swapping neighbours that are in the wrong order.\n\nIn five minutes you’ll watch values bubble through an array, then write the key line of a swap."
    },
    {
      "id": "p1",
      "type": "predict",
      "prompt": "What does this program print?",
      "code": "import java.util.Arrays;\n\npublic class Main {\n    public static void main(String[] args) {\n        int[] a = {5, 1, 4, 2};\n        for (int i = 0; i < a.length - 1; i++) { //~ One pass: compare each neighbouring pair.\n            if (a[i] > a[i + 1]) { //~ Out of order? Swap the pair.\n                int t = a[i]; //~ Save a[i] first, or it would be overwritten.\n                a[i] = a[i + 1];\n                a[i + 1] = t;\n            }\n        }\n        System.out.println(Arrays.toString(a)); //~ After ONE pass the biggest value has bubbled to the end.\n    }\n}",
      "options": [
        {
          "text": "[5, 4, 2, 1]",
          "why": "Swaps happen when the LEFT value is bigger, which moves big values rightward."
        },
        {
          "text": "[1, 4, 2, 5]",
          "why": "Right. One pass only guarantees the largest value reaches the end."
        },
        {
          "text": "[1, 2, 4, 5]",
          "why": "That needs more passes. One pass moves the maximum to the end; 4 and 2 are still out of order."
        },
        {
          "text": "[1, 5, 4, 2]",
          "why": "5 keeps being swapped rightward until it reaches the end."
        }
      ],
      "answer": 1
    },
