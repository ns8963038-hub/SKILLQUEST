# Copy to .env and fill in. NEVER commit .env.

# Must match the backend's INTERNAL_API_KEY. The AI service rejects any request
# to an internal route that doesn't present this exact key.
INTERNAL_API_KEY=

# Supabase Postgres pooled connection string (same DB as the backend).
# The AI service reads events/features and writes scores. Not needed yet at M0.
DATABASE_URL=
