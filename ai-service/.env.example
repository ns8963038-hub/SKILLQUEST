# Copy to .env and fill in. NEVER commit .env.

# Must match the backend's INTERNAL_API_KEY. The AI service rejects any request
# to an internal route that doesn't present this exact key.
INTERNAL_API_KEY=

# Supabase Postgres pooled connection string (same DB as the backend). The
# roadmap engine reads the skill graph from it.
DATABASE_URL=

# Optional: where the embedding model is cached. On Render this is set to a
# folder inside the project so the model is downloaded once, at build time.
# FASTEMBED_CACHE_PATH=.fastembed_cache
