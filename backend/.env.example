# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (the Vite dev server, later the Vercel URL)
CORS_ORIGINS=http://localhost:5173

# Supabase Postgres. Prisma connects as a normal Postgres role, NOT with the
# service-role API key. Two URLs (both from Supabase dashboard -> Connect):
#   DATABASE_URL = Transaction pooler (port 6543, ?pgbouncer=true) — app runtime
#   DIRECT_URL   = Session pooler     (port 5432)                  — migrations
DATABASE_URL=
DIRECT_URL=

# Supabase project URL (https://<project-ref>.supabase.co). REQUIRED: access
# tokens are verified against the project's public keys at
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json (ES256), not a shared secret.
SUPABASE_URL=

# Legacy HS256 secret — no longer used for verification; leave empty.
SUPABASE_JWT_SECRET=

# Shared secret for Web API -> AI service calls (must match the AI service's copy).
INTERNAL_API_KEY=

# Base URL of the Python AI service.
AI_SERVICE_URL=http://localhost:8000

# Where student code runs: paiza (free public runner, the default for real use),
# mock (fake results, for offline development), piston or judge0 (self-hosted;
# then also set PISTON_URL or JUDGE0_URL). See docs/notes/M6-uat-readiness.md §9.
EXECUTION_BACKEND=paiza
# PAIZA_URL=https://api.paiza.io
# PAIZA_API_KEY=guest
# JUDGE0_URL=

# Comma-separated Supabase user ids (UUIDs) that get the internal research
# console (/admin view): risk tiers, UAT metrics and pseudonymised CSV exports.
# Ids, not emails — see src/env.ts. Find them in Supabase → Authentication → Users.
ADMIN_USER_IDS=
