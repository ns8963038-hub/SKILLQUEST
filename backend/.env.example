# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (the Vite dev server, later the Vercel URL)
CORS_ORIGINS=http://localhost:5173

# Supabase Postgres — the POOLED connection string (Supavisor, port 6543).
# Supabase dashboard -> Project Settings -> Database -> Connection string -> "Transaction" pooler.
# Prisma connects as a normal Postgres role, NOT with the service-role API key.
DATABASE_URL=

# Supabase project ref + JWT secret, used to verify the access token on each request.
# Dashboard -> Project Settings -> API.
SUPABASE_JWT_SECRET=

# Shared secret for Web API -> AI service calls (must match the AI service's copy).
INTERNAL_API_KEY=

# Base URL of the Python AI service.
AI_SERVICE_URL=http://localhost:8000
